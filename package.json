{
  "name": "nexprobyte-technologies-web",
  "version": "1.0.0",
  "description": "Reverse engineered high-fidelity Next.js web application for Nexprobyte Technologies",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "node scripts/prepare_build.js && next build",
    "start": "node server.js",
    "serve": "node server.js",
    "test": "node verify_build.js && node verify_animations.js"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.546.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "keywords": [
    "nexprobyte",
    "framer",
    "reverse-engineered",
    "nextjs",
    "react",
    "framer-motion"
  ],
  "author": "Nexprobyte Technologies",
  "license": "ISC"
}
